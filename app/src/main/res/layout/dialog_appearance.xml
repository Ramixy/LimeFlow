<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/theme"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/appearance_system"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="18dp"
        android:gravity="start|center_vertical"
        android:text="@string/theme_system_short"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:cornerRadius="22dp"
        app:icon="@drawable/ic_theme_auto"
        app:iconGravity="textStart"
        app:iconPadding="14dp"
        app:iconSize="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/appearance_light"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:gravity="start|center_vertical"
        android:text="@string/theme_light"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:cornerRadius="22dp"
        app:icon="@drawable/ic_theme_light"
        app:iconGravity="textStart"
        app:iconPadding="14dp"
        app:iconSize="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/appearance_dark"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:gravity="start|center_vertical"
        android:text="@string/theme_dark"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:cornerRadius="22dp"
        app:icon="@drawable/ic_theme_dark"
        app:iconGravity="textStart"
        app:iconPadding="14dp"
        app:iconSize="24dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="?attr/colorControlHighlight" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/appearance_dynamic"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/dynamic_colors"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/appearance_palettes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="?attr/colorControlHighlight" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/palette_title_short"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/palette_limeflow"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#1769E0"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/white" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/palette_indigo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="22dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#65558F"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/white" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/palette_forest"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="22dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#5F5D68"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/white" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/palette_espresso"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="22dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#8B5747"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
