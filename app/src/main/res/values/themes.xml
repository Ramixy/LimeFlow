<resources>
    <!-- Base application theme. -->
    <style name="Theme.LimeFlow" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/lime_primary</item>
        <item name="colorPrimaryVariant">@color/lime_primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/lime_secondary</item>
        <item name="colorSecondaryVariant">@color/lime_primary_variant</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">?android:attr/colorBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="ThemeOverlay.LimeFlow" parent="" />

    <style name="ThemeOverlay.LimeFlow.Dynamic" parent="ThemeOverlay.LimeFlow.Blue" />

    <style name="ThemeOverlay.LimeFlow.Blue" parent="ThemeOverlay.LimeFlow">
        <item name="colorPrimary">#1769E0</item>
        <item name="colorPrimaryVariant">#0D47A1</item>
        <item name="colorSecondary">#4094F7</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSurface">#FFFFFFFF</item>
        <item name="android:colorBackground">#FFF5F9FF</item>
        <item name="android:textColorPrimary">#FF10233F</item>
        <item name="android:textColorSecondary">#FF60748F</item>
    </style>

    <style name="ThemeOverlay.LimeFlow.Indigo">
        <item name="colorPrimary">#5B588D</item>
        <item name="colorPrimaryVariant">#46366F</item>
        <item name="colorSecondary">#5B588D</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSurface">#FFF6F3FA</item>
        <item name="android:colorBackground">#FFFBF8FF</item>
        <item name="android:textColorPrimary">#FF1B1B1F</item>
        <item name="android:textColorSecondary">#FF47464F</item>
    </style>

    <style name="ThemeOverlay.LimeFlow.Forest">
        <item name="colorPrimary">#5F5D68</item>
        <item name="colorPrimaryVariant">#474550</item>
        <item name="colorSecondary">#5F5D68</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSurface">#FFF7F2FA</item>
        <item name="android:colorBackground">#FFFCF8FF</item>
        <item name="android:textColorPrimary">#FF1D1B20</item>
        <item name="android:textColorSecondary">#FF48454E</item>
    </style>

    <style name="ThemeOverlay.LimeFlow.Espresso">
        <item name="colorPrimary">#6D4C41</item>
        <item name="colorPrimaryVariant">#4E342E</item>
        <item name="colorSecondary">#8D6E63</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSurface">#FFF5F0EB</item>
        <item name="android:colorBackground">#FFFFFBF7</item>
        <item name="android:textColorPrimary">#FF1C1B1A</item>
        <item name="android:textColorSecondary">#FF5D4037</item>
    </style>
</resources>
